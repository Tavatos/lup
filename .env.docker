# ===== DJANGO CORE =====
DEBUG=False
SECRET_KEY=django-insecure-7y@-_9z=z$y6q9^p1&2f3g4h5j6k7l8m9n0o1p2q3r4s5t6u7v8w9x0y
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ENVIRONMENT=production

# ===== DATABASE (Docker internal network) =====
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=lup_db
DB_USER=lup_user
DB_PASSWORD=lup_password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

# ===== REDIS (Docker internal network) =====
REDIS_URL=redis://redis:6379/0

# ===== ELASTICSEARCH (Docker internal network) =====
ELASTICSEARCH_URL=http://elasticsearch:9200/
ELASTICSEARCH_INDEX_PREFIX=lup
SKIP_ELASTICSEARCH_SIGNALS=True

# ===== SECURITY (For Docker) =====
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ===== EMAIL (Console output for Docker testing) =====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@lupapp.com

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== SENTRY (Optional Error Tracking) =====
SENTRY_DSN=

# ===== CELERY =====
CELERY_BROKER_URL=redis://redis:6379/1

# ===== SENTRY (ERROR TRACKING) =====
SENTRY_DSN=

# ===== CELERY =====
# Note: Usually same as REDIS_URL but different database
CELERY_BROKER_URL=redis://localhost:6379/1
