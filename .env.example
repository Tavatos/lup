# ===== DJANGO CORE =====
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ENVIRONMENT=production

# ===== DATABASE =====
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=lup_db
DB_USER=lup_user
DB_PASSWORD=secure_password_change_me
DB_HOST=localhost
DB_PORT=5432

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0

# ===== ELASTICSEARCH =====
ELASTICSEARCH_URL=http://localhost:9200/
ELASTICSEARCH_INDEX_PREFIX=lup
SKIP_ELASTICSEARCH_SIGNALS=True

# ===== SECURITY =====
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ===== EMAIL =====
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@lupapp.com

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== SENTRY (ERROR TRACKING) =====
SENTRY_DSN=

# ===== CELERY =====
# Note: Usually same as REDIS_URL but different database
CELERY_BROKER_URL=redis://localhost:6379/1
